# PC Doctor dependencies and generated files

# Node
node_modules/
frontend/node_modules/
test-results/
playwright-report/

# Python
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/pc_doctor.log
.pytest_cache/
backend/.pytest_cache/
tests/__pycache__/

# SQLite DB generated by populate_db.py or runtime
backend/knowledge.db
backend/pc_doctor.db
backend/resolution_cache.db

# Runtime-generated state files (machine-specific)
backend/control_center_audit.json
backend/control_center_queue.json
backend/devtools_managed_apps.json

# Config overrides
config/settings.local.json

# Rust / Tauri build artifacts (OS-specific — never commit these)
# They are regenerated automatically on each machine by cargo / tauri dev/build
frontend/target/
src-tauri/target/

# Chrome / browser profile data (auto-generated)
.pc-doctor-profile/

# Scratch / temporary dev files
scratch/
*.zip

# OS junk
.DS_Store
Thumbs.db
Desktop.ini
*.swp
*~
