# PC Doctor - Environment Configuration Template
# Copy this file to .env and populate with your own API keys if using external AI providers.
# NOTE: PC Doctor functions autonomously using local golden recipes (STATIC_DB) without external API keys.

# Optional AI Provider API Keys (for dynamic suggestions and AI chat)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# NVIDIA_API_KEY=your_nvidia_api_key_here

# Backend Configuration
PORT=8765
HOST=127.0.0.1
DEBUG=false
LOG_LEVEL=INFO

# Application Security
REQUIRE_EXPLICIT_APPROVAL=true
ENABLE_HARD_BLACKLIST=true
